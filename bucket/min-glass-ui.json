{
    "version": "1.1.0",
    "description": "Min Glass UI: Min-style Firefox Developer Edition setup with a dedicated profile and shortcut. Requires firefox-developer.",
    "homepage": "https://github.com/hrkcz001/min-glass-ui",
    "license": "MIT",
    "notes": [
        "Dedicated profile: persist\\min-glass-ui\\profile.",
        "First install copies (does not move) an existing firefox-developer profile.",
        "Launch with the separate 'Firefox Dev (Min Glass)' Start Menu shortcut.",
        "Uninstall keeps profile data; delete persist\\min-glass-ui manually to remove it."
    ],
    "depends": "firefox-developer",
    "url": "https://github.com/hrkcz001/min-glass-ui/releases/download/v1.1.0/min-glass-ui-1.1.0.xpi",
    "hash": "TODO",
    "pre_install": [
        "$script:PersistProfile = \"$persist_dir\\profile\"",
        "$script:SourceProfile = \"$appsdir\\..\\persist\\firefox-developer\\profile\"",
        "if (!(Test-Path $script:PersistProfile)) {",
        "    if (Test-Path \"$script:SourceProfile\\prefs.js\") {",
        "        info 'Migrating (copying) profile from firefox-developer...'",
        "        New-Item -ItemType Directory -Force -Path $script:PersistProfile | Out-Null",
        "        robocopy $script:SourceProfile $script:PersistProfile /E /XF parent.lock /NFL /NDL /NJH /NJS /NP | Out-Null",
        "        Remove-Item (Join-Path $script:PersistProfile 'parent.lock') -Force -ErrorAction SilentlyContinue",
        "    } else {",
        "        New-Item -ItemType Directory -Force -Path $script:PersistProfile | Out-Null",
        "    }",
        "}"
    ],
    "installer": {
        "script": [
            "$ffExe = \"$appsdir\\firefox-developer\\current\\firefox.exe\"",
            "if (!(Test-Path $ffExe)) { error 'firefox-developer not found.'; abort }",
            "$extDir = Join-Path $script:PersistProfile 'extensions'",
            "New-Item -ItemType Directory -Force -Path $extDir | Out-Null",
            "Copy-Item \"$dir\\min-glass-ui-1.1.0.xpi\" (Join-Path $extDir 'min-glass-ui@local.xpi') -Force",
            "$userJs = Join-Path $script:PersistProfile 'user.js'",
            "if (!(Test-Path $userJs) -or !(Select-String -Path $userJs -Pattern 'xpinstall.signatures.required' -Quiet -ErrorAction SilentlyContinue)) {",
            "    Add-Content $userJs 'user_pref(\"xpinstall.signatures.required\", false);' -Encoding ASCII",
            "}",
            "$lnkDir = Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\Scoop Apps'",
            "New-Item -ItemType Directory -Force -Path $lnkDir | Out-Null",
            "$ws = New-Object -ComObject WScript.Shell",
            "$lnk = $ws.CreateShortcut((Join-Path $lnkDir 'Firefox Dev (Min Glass).lnk'))",
            "$lnk.TargetPath = $ffExe",
            "$lnk.Arguments = \"-profile `\"$script:PersistProfile`\"\"",
            "$lnk.IconLocation = \"$ffExe,0\"",
            "$lnk.WorkingDirectory = Split-Path $ffExe",
            "$lnk.Save()"
        ]
    },
    "uninstaller": {
        "script": [
            "$lnk = Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\Scoop Apps\\Firefox Dev (Min Glass).lnk'",
            "if (Test-Path $lnk) { Remove-Item $lnk -Force }",
            "$xpi = Join-Path $persist_dir 'profile\\extensions\\min-glass-ui@local.xpi'",
            "if (Test-Path $xpi) { Remove-Item $xpi -Force }",
            "warn 'Profile data kept in persist\\min-glass-ui\\profile.'"
        ]
    },
    "checkver": {
        "github": "https://github.com/hrkcz001/min-glass-ui"
    },
    "autoupdate": {
        "url": "https://github.com/hrkcz001/min-glass-ui/releases/download/v$version/min-glass-ui-$version.xpi"
    }
}
